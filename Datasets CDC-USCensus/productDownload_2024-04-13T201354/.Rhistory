rm(list=ls())
library(readr)
library(dplyr)
############SUICIDIOS DB----
#####cARGAR BASES DE DATPS DE SUICIDIOS DEL WORDER DATABSE DEL CDC(CENTER FOR DECEASE AND PREVENTION)
setwd("C:/Users/jufem/OneDrive/Documentos/Econometrica/Datasets CDC-USCensus")
suicides_1 <- read_delim("Suicide cause of Death 2010-2014 .txt", delim = "\t", escape_double = FALSE, trim_ws = TRUE)
suicides_2 <- read_delim("Suicide cause of Death 2015-2019 .txt", delim = "\t", escape_double = FALSE, trim_ws = TRUE)
suicides<-bind_rows(suicides_1,suicides_2)[,-1]
View(suicides)
#Data de suicidios por condado,
#  obtenido de https://wisqars.cdc.gov/explore/?o=MORT&y1=2010&y2=2019&g=00&t=0&i=2&m=20810&d=&s=0&r=0&me=0&ry=0&yp=65&e=0&a=ALL&a1=0&a2=199&g1=0&g2=199
#data de 2010-2019
summary(suicides$Deaths) #Tabla de sucidios
############INCOME DB----
#####cARGAR BASES DE DATOS DEL US BUREAU CENSUS
setwd("C:/Users/jufem/OneDrive/Documentos/Econometrica/Datasets CDC-USCensus/productDownload_2024-04-13T201354")
#Leer tablas de los datasets para cada anno (2010-2019)
tab2010<-read.csv("ACSDT1Y2010.B07011-Data.csv")
tab2011<-read.csv("ACSDT1Y2011.B07011-Data.csv")
tab2012<-read.csv("ACSDT1Y2012.B07011-Data.csv")
tab2013<-read.csv("ACSDT1Y2013.B07011-Data.csv")
tab2014<-read.csv("ACSDT1Y2014.B07011-Data.csv")
tab2015<-read.csv("ACSDT1Y2015.B07011-Data.csv")
tab2016<-read.csv("ACSDT1Y2016.B07011-Data.csv")
tab2017<-read.csv("ACSDT1Y2017.B07011-Data.csv")
tab2018<-read.csv("ACSDT1Y2018.B07011-Data.csv")
tab2019<-read.csv("ACSDT1Y2019.B07011-Data.csv")
#Funcion para limpiar los ID por county
clean_county_id <- function(GEO_ID) { as.numeric(sub(".*US(\\d+).*", "\\1", GEO_ID))
}# Definir la función para limpiar los nombres de los condados
for (i in 2010:2019) {
tab_name <- paste0("tab", i)
assign(tab_name, transform(get(tab_name), GEO_ID = clean_county_id(GEO_ID)))
}# Aplicar la función a cada dataframe
#La variable B07011_001E original de la base de datos es: Median income table Estimate!!Median income in the past 12 months, le renombramos como Med_Income para todas las tablas
for (i in 2010:2019) {
tab_name <- paste0("tab", i)
suppressWarnings(assign(tab_name, transform(get(tab_name), Med_Income = as.numeric(B07011_001E))))
}
library(dplyr)
tab2010 <- tab2010 %>% mutate(year = '2010')
tab2011 <- tab2011 %>% mutate(year = '2011')
tab2012 <- tab2012 %>% mutate(year = '2012')
tab2013 <- tab2013 %>% mutate(year = '2013')
tab2014 <- tab2014 %>% mutate(year = '2014')
tab2015 <- tab2015 %>% mutate(year = '2015')
tab2016 <- tab2016 %>% mutate(year = '2016')
tab2017 <- tab2017 %>% mutate(year = '2017')
tab2018 <- tab2018 %>% mutate(year = '2018')
tab2019 <- tab2019 %>% mutate(year = '2019')
###########UNIENDO TABLAS----
tabla_total=bind_rows(tab2010[-1,], tab2011[-1,],tab2012[-1,],tab2013[-1,],tab2014[-1,],tab2015[-1,],tab2016[-1,],tab2017[-1,],tab2018[-1,],tab2019[-1,])
tabla_total$GEO_ID<-as.character(tabla_total$GEO_ID)
tabla_total$year<-as.character(tabla_total$year)
suicides$Year<-as.character(suicides$Year)
tabla_total=tabla_total %>%
inner_join(suicides, by = c("GEO_ID" = "County Code", "year" = "Year")) %>%
select("County","year","Deaths","Med_Income","Gender","Race")
View(tabla_total)
#GRAFICOS----
#promedio_por_anno <- bind_cols(aggregate(Med_Income ~ year, data = tabla_total, FUN = mean) , aggregate(Deaths ~ year, data = tabla_total, FUN = mean))
promedio_por_anno <- tabla_total %>%
group_by(year) %>%
summarise(
Avg_Med_Income = mean(Med_Income, na.rm = TRUE),
Avg_Deaths = mean(Deaths, na.rm = TRUE)
)
plot(y = promedio_por_anno$Avg_Med_Income, x = promedio_por_anno$year,
type = "o", # o para línea, p para puntos, b para ambos
main = "Promedio del ingreso mediano y \n promedio de numero de suicidios \n por Año", # Título del gráfico
xlab = "Año", # Etiqueta del eje x
ylab = "Promedio de ingreso mediano" # Etiqueta del eje y
,col='red'
)
library(ggplot2)
ggplot(data = promedio_por_anno, aes(x = (year), y = Avg_Med_Income)) +
geom_line(aes(group = 1),col = "salmon") + # Utilizar líneas para conectar los puntos
geom_point(col = "salmon") + # Agregar puntos
labs(title = "Promedio del ingreso mediano y \n promedio de numero de suicidios \n por Año", # Título del gráfico
x = "Año", # Etiqueta del eje x
y = "Promedio de ingreso mediano"
)
##############graficando ambos ingreso mediano en miles y decesoss por suicidio
Med_Income_x1000<-tabla_total$Med_Income/1000 #Ingreso mediano por hogares en miles de dolares Y MUERTES POR SUICIDIO
promedio_por_anno <- merge(aggregate( Med_Income_x1000~ year, data = tabla_total, FUN = mean),
aggregate(Deaths ~ year, data = tabla_total, FUN = mean),
by = "year")
ggplot(data = promedio_por_anno, aes(x = year)) +
geom_line(aes(y = Med_Income_x1000, group = 1), col = "salmon") +
geom_point(aes(y = Med_Income_x1000), col = "salmon") +
geom_line(aes(y = Deaths, group = 1), col = "navyblue") +
geom_point(aes(y = Deaths), col = "navyblue") +
labs(title = "Promedio del ingreso mediano y \n promedio de numero de suicidios \n por Año",
x = "Año",
y = "Promedio de ingreso mediano (en miles) y decesos") +
scale_y_continuous(sec.axis = sec_axis(~., name = "Promedio de decesos"))
########Tablas----
promedio<-mean(promedio_por_anno$Med_Income)
std_eror<-sqrt(var(promedio_por_anno$Med_Income))
modelo1<-lm(Deaths~Med_Income+Gender+Race,data=tabla_total)
summary(modelo1)
library(plm)
modelo2<-plm(Deaths~Med_Income+Gender+Race,data=tabla_total,index = c("year"), model = "within")
summary(modelo2)
